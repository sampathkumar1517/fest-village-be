PORT=3000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-secret

# --- Supabase Postgres (pick ONE style) ---

# Option A: full URL (recommended on Koyeb)
# Replace [YOUR-PASSWORD] with your Supabase DB password (URL-encode special chars)
# Direct:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rtgcaaixxzhlxuumomdw.supabase.co:5432/postgres
# Session pooler (use if direct/IPv6 fails):
# DATABASE_URL=postgresql://postgres.rtgcaaixxzhlxuumomdw:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Option B: separate fields
DB_HOST=db.rtgcaaixxzhlxuumomdw.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres

# Required for Supabase (TLS)
DB_SSL=true

# Auto-create tables from TypeORM entities on startup
DB_SYNC=true

# Bootstrap organizer (created on server start)
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=organizer@festvillage.local
ADMIN_FIRST_NAME=Organizer
