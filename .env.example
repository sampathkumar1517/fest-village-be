PORT=3000
NODE_ENV=production
JWT_SECRET=fest-village-dev-secret-change-in-production

# Public backend base URL (for docs / external keep-alive cron).
# Cron should hit: GET ${BACKEND_URL}/health every ~13 minutes.
# Do not hard-code this URL in application source.
BACKEND_URL=https://your-production-backend-url

# --- Supabase Postgres (pick ONE style) ---

# RECOMMENDED for SnapDeploy / Koyeb / Vercel / most cloud hosts (IPv4):
# Supabase → Connect → Session mode → copy connection string
# Username MUST be postgres.<project-ref> (not plain postgres)
# DATABASE_URL=postgresql://postgres.rtgcaaixxzhlxuumomdw:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Direct connection (IPv6 only — fails on SnapDeploy with ENETUNREACH):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rtgcaaixxzhlxuumomdw.supabase.co:5432/postgres

# Option B: separate fields (use pooler host + pooler username)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres

# Required for Supabase (TLS)
DB_SSL=true

# Auto-create tables from TypeORM entities on startup
DB_SYNC=true

# Bootstrap organizer (created on server start)
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=organizer@festvillage.local
ADMIN_FIRST_NAME=Organizer
